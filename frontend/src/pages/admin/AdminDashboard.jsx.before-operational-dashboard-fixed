      pending: Number(loans?.pending ?? 0),
      underReview: Number(loans?.underReview ?? 0),
      approved: Number(loans?.approved ?? 0),
      active: Number(loans?.active ?? 0),
      defaulted: Number(loans?.defaulted ?? 0),

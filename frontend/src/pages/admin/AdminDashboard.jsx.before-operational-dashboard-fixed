  const [statistics, setStatistics] = useState(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");

  /*
  |--------------------------------------------------------------------------
  | LOAD LIVE STATISTICS
  |--------------------------------------------------------------------------
  */

  const loadStatistics = useCallback(async (isRefresh = false) => {
    if (isRefresh) {
      setRefreshing(true);
    } else {
      setLoading(true);
    }

    setError("");

    try {
      const response = await api.get("/admin/statistics");

      setStatistics(
        normalizeStatistics(response?.data),
      );
    } catch (requestError) {
      const message =
        requestError?.response?.data?.message ||
        requestError?.response?.data?.error ||
        requestError?.message ||
        "Unable to load administrative statistics.";

      setError(message);
      setStatistics(null);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    loadStatistics();
  }, [loadStatistics]);

  /*
  |--------------------------------------------------------------------------
  | DERIVED METRICS
  |--------------------------------------------------------------------------
  */

  const operationalRate = useMemo(() => {
    if (!statistics || statistics.accounts <= 0) {
      return null;
    }

    return Math.round(
      (statistics.activeAccounts /
        statistics.accounts) *
        100,
    );
  }, [statistics]);

  /*
  |--------------------------------------------------------------------------
  | LOADING
  |--------------------------------------------------------------------------
  */

  if (loading) {
    return (
      <div className="min-h-full bg-slate-50 p-4 sm:p-6 lg:p-8">

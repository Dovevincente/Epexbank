  const customers = source?.customers || {};
  const accounts = source?.accounts || {};
  const kyc = source?.kyc || {};
  const transactions = source?.transactions || {};
  const transfers = source?.transfers || {};
  const deposits = source?.deposits || {};
  const withdrawals = source?.withdrawals || {};
  const loans = source?.loans || {};
  const cards = source?.cards || {};
  const payments = source?.payments || {};
  const investments = source?.investments || {};
  const shares = source?.shares || {};
  const support = source?.support || {};
  const savings = source?.savings || {};

  return {
    customers: Number(customers?.total ?? 0),
    activeCustomers: Number(customers?.active ?? 0),
    suspendedCustomers: Number(customers?.suspended ?? 0),
    blockedCustomers: Number(customers?.blocked ?? 0),

    accounts: Number(accounts?.total ?? 0),
    activeAccounts: Number(accounts?.active ?? 0),
    frozenAccounts: Number(accounts?.frozen ?? 0),
    suspendedAccounts: Number(accounts?.suspended ?? 0),
    restrictedAccounts: Number(accounts?.restricted ?? 0),

    kyc: {
      pending: Number(kyc?.pending ?? 0),
      underReview: Number(kyc?.underReview ?? 0),
      verified: Number(kyc?.verified ?? 0),
      rejected: Number(kyc?.rejected ?? 0),
    },

    transactions: {
      total: Number(transactions?.total ?? 0),
      pending: Number(transactions?.pending ?? 0),
      processing: Number(transactions?.processing ?? 0),
      completed: Number(transactions?.completed ?? 0),
      failed: Number(transactions?.failed ?? 0),
      reversed: Number(transactions?.reversed ?? 0),
      today: Number(transactions?.today ?? 0),
    },

    transfers: {
      total: Number(transfers?.total ?? 0),
      pending: Number(transfers?.pending ?? 0),
      processing: Number(transfers?.processing ?? 0),
      completed: Number(transfers?.completed ?? 0),
      failed: Number(transfers?.failed ?? 0),
      today: Number(transfers?.today ?? 0),
    },

    deposits: {
